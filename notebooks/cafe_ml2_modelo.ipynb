     "text": [
      "Silhouette: 0.39\n",
      "Inercia: 3985.97\n"
     ]
    }
   ],
   "source": [
    "from sklearn.metrics import silhouette_score\n",
    "\n",
    "X_processed = model[:-1].transform(X)\n",
    "\n",
    "score = silhouette_score(X_processed, labels)\n",
    "print(\"Silhouette:\", round(score, 3))\n",
    "print(\"Inercia:\", round(model[-1].inertia_, 2))"
   ]
  },
